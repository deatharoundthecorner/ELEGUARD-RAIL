# EleGuard Rail — Apache Access Restrictions
# Prevent access to environment files, VCS metadata, and database backups

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "^\.git">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|bak|backup)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Deny direct access to non-public backend directories
    RewriteRule ^(app|database|tests|docs|scratch)/ - [F,L]
</IfModule>

Options -Indexes
